# Set by `npx convex dev` (do not hand-edit unless you know the deployment id)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Convex Dashboard only (never commit values; see CONVEX.md)
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
DEMO_PASSCODE=

# Vercel / Next server (seed route) — same passcode as Convex prod when gated
# DEMO_PASSCODE is also read in app/api/seed via process.env

# Optional: append ?key= to marketing demo links (not a secret if passcode rotates separately)
NEXT_PUBLIC_DEMO_KEY=

# Unused in Steward default stack
XAI_API_KEY=
