# Convex deployment variables: set these in the Convex dashboard, not the
# Next.js client. The local UI does not need a provider key in .env.local.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
# Optional alternate provider; leave unset when using Anthropic.
XAI_API_KEY=

# Local development: populated by `npx convex dev` for the existing project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Production: set the SAME passcode in Convex prod and Vercel Production.
# Omitting it disables the demo write gate; this is not full authentication.
DEMO_PASSCODE=

# Optional PUBLIC value embedded in landing links/client assets. Set only for
# a deliberately public demo; otherwise leave empty and share ?key= privately.
# If set, it must match DEMO_PASSCODE.
NEXT_PUBLIC_DEMO_KEY=

# Vercel Production build only: production deploy key from the existing Convex
# deployment. Keep out of client code and scope to Production, not Preview.
# Build command: bash scripts/deploy-production.sh --deploy
# The script injects the matching NEXT_PUBLIC_CONVEX_URL during the build.
CONVEX_DEPLOY_KEY=
